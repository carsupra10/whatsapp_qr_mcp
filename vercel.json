{
  "version": 2,
  "name": "whatsapp-mcp-server",
  "buildCommand": "echo 'No build needed for API-only deployment'",
  "installCommand": "npm install --production=false --no-optional @vercel/node typescript @types/node",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10,
      "memory": 512
    }
  },
  "github": {
    "silent": true
  }
}
