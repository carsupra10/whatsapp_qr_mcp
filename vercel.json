{
  "version": 2,
  "name": "whatsapp-mcp-server",
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ],
  "env": {
    "SESSION_PATH": "/tmp/.wwebjs_auth",
    "QUEUE_DB_PATH": "/tmp/queue.json",
    "MIN_DELAY": "5000",
    "MAX_DELAY": "15000",
    "MAX_RETRIES": "3",
    "MESSAGES_PER_MINUTE": "10",
    "NODE_ENV": "production"
  },
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
