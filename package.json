{
  "name": "whatsapp-mcp-server",
  "version": "1.0.0",
  "description": "WhatsApp MCP server with QR auth and queue management for Vercel",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/post-build.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "vercel-build": "npm run build",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "whatsapp",
    "mcp",
    "vercel",
    "queue",
    "chatgpt",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "whatsapp-web.js": "^1.23.0",
    "qrcode-terminal": "^0.12.0",
    "qrcode": "^1.5.3",
    "express": "^4.18.2",
    "lowdb": "^7.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
