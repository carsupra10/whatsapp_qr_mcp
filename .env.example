# WhatsApp MCP Server Configuration

# Session storage path (where WhatsApp auth data is stored)
SESSION_PATH=./.wwebjs_auth

# Queue database path
QUEUE_DB_PATH=./queue.json

# Queue configuration
MIN_DELAY=5000          # Minimum delay between messages (ms)
MAX_DELAY=15000         # Maximum delay between messages (ms)
MAX_RETRIES=3           # Maximum retry attempts for failed messages
MESSAGES_PER_MINUTE=10  # Rate limit for sending messages

# For Vercel deployment, these will be set automatically
# SESSION_PATH=/tmp/.wwebjs_auth
# QUEUE_DB_PATH=/tmp/queue.json
